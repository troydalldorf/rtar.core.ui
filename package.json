{
  "name": "@rtar/core-ui",
  "version": "0.4.0",
  "description": "Shared web UI for the rtar browser apps (Vantage, admin). React, framework-agnostic (no UI-library dependency).",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10",
    "remark-gfm": "^4"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.3.5",
    "typescript": "~5.8.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
